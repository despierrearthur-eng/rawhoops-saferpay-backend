# Copy real values into the Vercel project's Environment Variables dashboard.
# Never commit an actual .env file with real values — .gitignore already excludes it.

# From Saferpay Backoffice > Account admin
SAFERPAY_CUSTOMER_ID=
SAFERPAY_TERMINAL_ID=

# From Saferpay Backoffice > Settings > JSON API basic authentication
SAFERPAY_USERNAME=
SAFERPAY_PASSWORD=

# "test" while testing, "live" only once you're ready to take real payments
SAFERPAY_ENV=test

# rawhoops.be's public site (used to build the ReturnUrl and for CORS)
SITE_BASE_URL=https://www.rawhoops.be

# This backend's own public URL (used to build the Notification callback URLs).
# Leave unset on Vercel — it falls back to the deployment's own VERCEL_URL automatically.
# Only set this if you attach a custom domain like api.rawhoops.be.
BACKEND_BASE_URL=
